iseLevel: string; //level of expertise required for the experience\n  primaryLanguage: string; //primary language of the experience\n  secondaryLanguage: string; //secondary language of the experience (if applicable)\n  isScholorSlotAvailable: boolean; //whether or not scholarship slots are available for the experience\n  numberOfScholor?: number; //number of scholarship slots available (if applicable)\n  canBookOngoingEvent?: boolean; //whether or not the experience can be booked on an ongoing basis\n  cutOffTime?: number; //cut-off time for booking the experience (in milliseconds)\n  cutOffTimeUnit?: string; //unit of time for cut-off time (e.g. hours, days)\n  experienceDuration?: number; //duration of the experience (in milliseconds)\n  maximunHourGuestCanBook?: number; //maximum number of hours a guest can book the experience (in milliseconds)\n  recurringScholarshipSlotType: string; //whether scholarship slots are available for all dates or specific days only\n  scholorshipEndType?: string; //end type for scholarship slots (e.g. never, on a specific date)\n  scholorshipEndDate?: Date; //end date for scholarship slots (if applicable)\n  scholarShipRecurringWeek?: number[]; //recurring days of the week for scholarship slots (if applicable)\n  currencyType: string; //type of currency for the experience\n\n  // Pricing information\n```", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=-1, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=4, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None), prompt_token_ids: [128000, 96556, 0, 5810, 374, 279, 2800, 315, 279, 32828, 4729, 1646, 369, 11704, 449, 3779, 6170, 512, 14196, 4077, 475, 21055, 505, 364, 30410, 14, 18837, 10867, 1025, 475, 314, 602, 4812,